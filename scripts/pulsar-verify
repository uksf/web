#!/usr/bin/env bash
set -euo pipefail

[[ $# -eq 1 && -d $1 ]] || { echo "usage: pulsar-verify <candidate checkout>" >&2; exit 2; }
found="$(command -v bun || true)"
bun="$(readlink -f "${found:-/nonexistent}" || true)"
[[ $bun == /opt/clacks-factory/bun/*/bin/bun ]] || { echo "pulsar-verify: bun on PATH '${found:-missing}' resolves to '${bun:-missing}', expected /opt/clacks-factory/bun/*/bin/bun" >&2; exit 1; }

cd "$1"
"$bun" install --frozen-lockfile
"$bun" x ng build -c production
